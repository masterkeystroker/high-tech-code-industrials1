<Window x:Class="LaunchCretaPerfMonHidden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creta Performance Monitor Launcher" Height="350" Width="300">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <CheckBox Name="Test1" Content="CheckBox" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <CheckBox Name="Test1b" Content="CheckBox" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </StackPanel>
            <CheckBox Name="Test2" Content="CheckBox" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <CheckBox Name="Test3" Content="CheckBox" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Button Content="Launch" Margin="5" Height="32" Name="btnLaunch" Width="64" Click="btnLaunch_Click" />
        </StackPanel>
    </Grid>
</Window>
